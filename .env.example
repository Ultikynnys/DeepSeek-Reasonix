DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_BASE_URL is accepted as an alias of DEEPSEEK_BASE_URL.
# GPT-5.6 family (gpt-5.6 / gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna) — required
# when you select a gpt-* model. OPENAI_BASE_URL overrides the default
# https://api.openai.com/v1 (proxies, Azure-compatible gateways).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Ollama — optional. Default is Ollama cloud https://ollama.com/v1, which needs a
# key from https://ollama.com/settings/keys; set OLLAMA_BASE_URL to the local
# daemon http://localhost:11434/v1 (keyless) for local models.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
# Console level only. Verbose file diagnostics in ~/.reasonix/diagnostics are always enabled.
REASONIX_LOG_LEVEL=INFO
# Set to 1 for an additional startup timing table on stderr; file timings are always recorded.
REASONIX_PROFILE_STARTUP=0
REASONIX_TRANSCRIPT_DIR=./transcripts
